# 모꼬지 — 약속 내기 환경변수 예시.
# 로컬 개발: 이 파일을 .env.local 로 복사해 값을 채운다(.env*.local 은 gitignore 됨).
# 빌드·OTA: 로컬 파일이 아니라 `eas env`(development / preview / production)에 둔다. OTA 는 `npm run ota`(production)·`npm run ota:beta`(beta 채널, preview 환경) 로만 발행한다 — 둘 다 이 파일(.env.local)을 읽지 않는다.

# 약속 내기 모드: off | fake | live   (값이 없으면 off)
#   off   약속 내기 UI 가 어디에도 보이지 않는다. 기존 앱과 완전히 같다.
#   fake  메모리 가짜 서버(봇 친구·시간 빨리 감기). 개발 번들(__DEV__)에서 켜진다(웹 프리뷰 `npm run web` 포함).
#         릴리스는 EAS 채널이 정확히 'beta' 인 네이티브 빌드(eas.json 의 beta 프로필, TestFlight 체험용)에서만 켜지고
#         production·preview 등 그 밖의 모든 릴리스와 웹 릴리스에서는 무조건 off 로 떨어진다.
#   live  Supabase(src/lateBet/supabaseApi.ts). 웹이 아니고 아래 두 키가 모두 있을 때만 켜진다(없으면 off).
#         웹·앱인토스 번들은 항상 off 이고 supabase-js 도 들어가지 않는다(src/lateBet/supabase.ts 자리표시자).
EXPO_PUBLIC_LATEBET_MODE=off

# live 모드 전용. Supabase 대시보드 → Project Settings → API Keys.
#   EXPO_PUBLIC_SUPABASE_URL  Project URL. 예: https://abcdefghijklmnop.supabase.co  (끝에 / 나 /rest/v1 을 붙이지 않는다)
#   EXPO_PUBLIC_SUPABASE_KEY  Publishable key — 'sb_publishable_…' 로 시작하는 값(구형 프로젝트면 anon 공개 키).
#                             EXPO_PUBLIC_ 이라 앱 번들에 평문으로 들어간다(공개 정보다. 보안은 RPC 검증·RLS·권한 회수가 맡는다).
#   secret(sb_secret_…) / service_role 키는 여기에도, eas env 에도, 채팅에도 절대 넣지 않는다. 이 앱은 그 키를 쓰지 않는다.
#   대시보드 Authentication → Sign In / Providers 에서 'Allow anonymous sign-ins' 를 켜야 한다(꺼져 있으면 LB_NOT_CONFIGURED).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# 네이티브 빌드 전용 (app.config.js 가 읽는다. EXPO_PUBLIC_ 이 아니라 번들에 실리지 않는다). 값은 `eas env` 에만 둔다.
# 안드로이드 구글 지도 키. 없으면 안드로이드 지도는 목록 폴백으로 그린다(extra.hasGoogleMapsKey=false). iOS 는 애플 지도라 불필요.
# 키 유무는 바이너리에 박힌 값만 쓴다 — 나중에 키를 등록해도 OTA 로는 켜지지 않고 새 빌드부터 지도가 나온다.
GOOGLE_MAPS_ANDROID_KEY=
# (선택, P5 푸시용) google-services.json 파일 경로. EAS 에서는 파일 환경변수로 둔다.
GOOGLE_SERVICES_JSON=

# (선택) 카카오 로컬 REST 키 — 장소 검색(상호명). 없으면 기기 geocoder 로 주소만 찾는다.
# EXPO_PUBLIC_ 이라 네이티브 번들에 평문으로 들어간다(웹 번들에는 안 들어감) — 카카오 콘솔에서 쿼터를 제한할 것.
# 검색할 때 지도 중심 좌표가 카카오로 전송된다.
EXPO_PUBLIC_KAKAO_REST_KEY=
