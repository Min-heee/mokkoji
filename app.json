{
  "expo": {
    "name": "엔빵",
    "slug": "nbbang",
    "version": "0.3.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/95aba195-94f4-4191-bcae-c7d104fd5327"
    },
    "scheme": "nbbang",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EFE9DB",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.minheee.nbbang",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.minheee.nbbang",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95aba195-94f4-4191-bcae-c7d104fd5327"
      }
    },
    "owner": "untitled98"
  }
}
