{
  "expo": {
    "name": "엔빵",
    "slug": "nbbang",
    "version": "0.3.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/95aba195-94f4-4191-bcae-c7d104fd5327"
    },
    "scheme": "nbbang",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3182F6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.minheee.nbbang",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.minheee.nbbang",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3182F6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "영수증을 촬영해 항목을 자동으로 입력하기 위해 카메라를 사용해요.",
          "photosPermission": "영수증 사진을 불러와 항목을 자동으로 입력하기 위해 사진 보관함에 접근해요."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95aba195-94f4-4191-bcae-c7d104fd5327"
      }
    },
    "owner": "untitled98"
  }
}
